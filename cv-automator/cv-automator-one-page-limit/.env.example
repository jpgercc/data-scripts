# Obrigatório: chave de API criada no dashboard do 9Router
NINE_ROUTER_API_KEY=your_9router_api_key_here

# Opcional: URL do 9Router local. Para instância remota, informe a sua URL com /v1.
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1

# Opcional: provedor de IA. O projeto usa somente 9router.
AI_PROVIDER=9router

# Opcional: modelo ou nome de Combo configurado no seu 9Router.
AI_MODEL=cc/claude-opus-4-7

# Opcional: diretórios de saída, templates e dados
OUTPUT_DIR=output
TEMPLATE_DIR=templates
DATA_DIR=data
